{
  "name": "smartswap-monorepo",
  "private": true,
  "workspaces": [
    "mobile",
    "api"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace=mobile run dev",
    "build:mobile": "npm --workspace=mobile run build",
    "test:mobile": "npm --workspace=mobile run test",
    "dev:api": "npm --workspace=api run start:dev",
    "build:api": "npm --workspace=api run build",
    "test:api": "npm --workspace=api run test",
    "test:e2e": "npm --workspace=api run test:e2e",
    "typecheck": "npm --workspace=mobile run typecheck && npm --workspace=api run typecheck",
    "graphify": "node scripts/graphify.mjs"
  }
}
