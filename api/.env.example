# Server Environment
PORT=3000
NODE_ENV=development

# Database Connections (PostgreSQL / Supabase Transaction & Session Pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartswap?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartswap?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-for-dev-change-in-prod-min-32-chars"
CORS_ORIGIN="*"

# AI Integration
OPENAI_API_KEY="sk-placeholder-openai-key-for-development"

# Supabase Project Configuration
SUPABASE_URL="https://smartswap-mock.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="mock-supabase-service-role-key-for-local-development"

# Shared password of the demo accounts created by `npm run db:seed`.
# Must match VITE_DEMO_PASSWORD in the mobile build.
SEED_DEMO_PASSWORD=
